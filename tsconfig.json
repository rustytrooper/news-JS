{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowJs": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "sourceMap": true,
        "strict": true,
        "noImplicitAny": true,
        "types": ["node"],
        "noUncheckedSideEffectImports": false
    },
    "include": ["src/**/*"]
}
